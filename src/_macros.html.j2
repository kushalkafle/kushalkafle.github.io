{# Shared macros for page templates. #}
{% macro authors(p) -%}
  {% for a in p.authors -%}
    {%- if a.me %}<strong>{{ a.name }}</strong>{% else %}{{ a.name }}{% endif %}{% if a.equal %}*{% endif %}
    {%- if not loop.last %}, {% endif %}
  {%- endfor %}
{%- endmacro %}

{% macro links(p, tab) -%}
  <div class="pub-links">
    {% for label, url in p.links %}
    <a href="{{ url }}"{% if url.startswith('http') %} target="_blank" rel="noopener"{% endif %}>{{ label }}</a>
    {% endfor %}
    <details class="bib"><summary>BibTeX</summary><pre>{{ p.bibtex }}</pre></details>
  </div>
{%- endmacro %}

{% macro meta(p) -%}
  <div class="pub-venue">
    <span class="venue">{{ p.venue_label }}</span>
    {% if p.award %}<span class="award">{{ p.award }}</span>{% endif %}
    {% if p.has_equal %}<span class="note">* equal contribution</span>{% endif %}
  </div>
{%- endmacro %}

{% macro card(p, tab) -%}
  <article class="pub-card">
    <div class="thumb">
      {% if p.thumb %}<img src="{{ p.thumb }}" alt="" loading="lazy">{% else %}<span>{{ p.venue }}</span>{% endif %}
    </div>
    <div class="pub-body">
      <h4 class="pub-title">{{ p.title }}</h4>
      <div class="pub-authors">{{ authors(p) }}</div>
      {{ meta(p) }}
      {{ links(p, tab) }}
    </div>
  </article>
{%- endmacro %}

{% macro entry(p, tab) -%}
  <li class="pub"{% if tab == 'all' %} id="pub-{{ p.key }}"{% endif %}>
    <div class="pub-title">{{ p.title }}</div>
    <div class="pub-authors">{{ authors(p) }}</div>
    {{ meta(p) }}
    {{ links(p, tab) }}
  </li>
{%- endmacro %}

{% macro by_year(list, tab) -%}
  {% for year, group in list | groupby('year') | reverse %}
  <h3 class="year">{{ year }}</h3>
  <ol class="pub-list">
    {% for p in group %}{{ entry(p, tab) }}{% endfor %}
  </ol>
  {% endfor %}
{%- endmacro %}
